{
  "mcpServers": {
    "tradingview": {
      "command": "node",
      "args": ["C:/Users/michael oregan/tradingview-mcp/dist/index.js"],
      "env": {
        "CDP_URL": "http://127.0.0.1:9223"
      }
    },
    "scheduler": {
      "command": "npx",
      "args": ["-y", "scheduler-mcp"]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/michael oregan/MOR-Trading"
      ]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "REPLACE_WITH_PAT_OR_USE_ENV_VAR"
      }
    },
    "pinescript-docs": {
      "command": "uvx",
      "args": ["pinescript-mcp"]
    },
    "computer-use": {
      "command": "npx",
      "args": ["-y", "claude-computer-use-mcp"]
    },
    "pinescript-strategy": {
      "command": "npx",
      "args": ["-y", "pinescript-mcp-server"]
    }
  }
